# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude
.claude/

# old subdirectory artifacts
wellness-app/

# monorepo subprojects (client/ + server/) — ignore build output at any depth
node_modules/
.next/
dist/
out/

# runtime file storage (uploaded office-visit recordings, etc.)
server/uploads/

# database backups — full production dumps carry client PII and password hashes; never push
*.backup

# One-off deletion snapshots written by server/scripts/return-lead-to-pool.mjs. They hold a real
# client's name, phone, appointments and payment rows — same reason the database backups above are
# never pushed. Keep them locally; they exist so a mistaken removal can be re-inserted.
server/scripts/deleted-lead-*.json

# Dev-server output (client-dev.log, server-dev.err.log, …). Regenerated on every `npm run dev` and
# specific to one machine, so it only ever appears as noise in git status.
*.log
