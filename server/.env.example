# ===== WellnessOS backend (server) =====
PORT=4000
# Comma-separated list of allowed client origins (CORS). Required for the two-server local dev
# setup (client on :3000, server on :4100). In production this server serves the frontend itself
# on the same origin, so CORS isn't needed there — leaving this empty now means NO cross-origin
# requests are allowed (fails closed), not "allow all".
CORS_ORIGIN=http://localhost:3000

# Signs login session tokens (server/src/shared/session.ts). REQUIRED — without it the server
# generates a random secret on every restart, which logs everyone out on each deploy. Generate one
# with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ----- PostgreSQL (the database) -----
PGHOST=
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=Wellness_Center_App
# Set PGSSL=false only if your Postgres does NOT use SSL (default assumes SSL).
PGSSL=

# ----- Meta / Facebook Lead Ads -----
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_PAGE_ACCESS_TOKEN=
META_SYSTEM_ACCESS_TOKEN=
META_PAGE_IDS=
META_TARGET_AD_ACCOUNTS=

# ----- Tata Tele / Smartflo telephony -----
TATA_TELE_API_KEY=
TATA_TELE_CALLER_ID=
TATA_TELE_DEFAULT_EXTENSION_NUMBER=
TATA_TELE_DEFAULT_AGENT_NUMBER=
TATA_TELE_USE_SUPPORT_FALLBACK=0
# Shared secret for the call-ended webhook (Smartflo has no request signing). Set this, then
# register the webhook URL in the Smartflo dashboard as .../api/calls/webhook/recording?secret=<value>.
# Until this is set, the webhook accepts unauthenticated requests (logged as a warning on each call).
TATA_WEBHOOK_SECRET=
